#!/bin/bash
set -euo pipefail
[[ $(cat /run/toddlerbox-system/mode) == child ]] || exit 1
cd /opt/toddlerbox/current
unset DISPLAY WAYLAND_DISPLAY SWAYSOCK
export SDL_VIDEODRIVER=wayland XDG_SESSION_TYPE=wayland LIBSEAT_BACKEND=logind
# Prefer GPU-backed composition on all hardware. Unaccelerated machines get
# one software attempt if startup fails before any supervised healthy frame.
export WLR_RENDERER=gles2 SDL_RENDER_DRIVER=software SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=0

startup_without_frame() {
    /usr/bin/python3 - <<'PY'
import json
from pathlib import Path
import sys
try:
    status = json.loads(Path("/run/toddlerbox-system/status.json").read_text())
    allowed = status.get("mode") == "child" and status.get("seen_frame") is False
except (OSError, ValueError, AttributeError):
    allowed = False
sys.exit(0 if allowed else 1)
PY
}

run_cage_session() {
    local renderer=$1 result
    shift
    if [[ $renderer == gles2 ]]; then
        if WLR_RENDERER=gles2 "$@"; then
            return 0
        else
            result=$?
        fi
        # Never relaunch after normal exit, a signal or a running child crash.
        # Missing/unreadable controller evidence fails closed into root recovery.
        if (( result >= 128 )) || ! startup_without_frame; then
            return "$result"
        fi
        printf '%s\n' 'GPU session startup failed; trying software composition once.' >&2
    fi
    WLR_RENDERER=pixman exec "$@"
}

export PYGAME_HIDE_SUPPORT_PROMPT=1 KIDBOX_CONFIG=/etc/toddlerbox/config.yaml
export TODDLERBOX_APP_CONTROL=1
# Child work lives where sync and setup expect it, whatever the editable config says.
export TODDLERBOX_DATA_ROOT=/var/lib/toddlerbox
export TODDLERBOX_HEALTH_SOCKET=/run/toddlerbox-health.sock
# One audio route for both activities; the child user manager owns the server.
# Bound startup so an unavailable audio device cannot strand session recovery.
timeout 8 systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service || true
timeout 2 /usr/local/libexec/toddlerbox-volume startup || true
export SDL_AUDIODRIVER=pulseaudio
# Cage owns the seat. Do not use -s (which enables virtual-terminal switching).
# Inhibitors live only as long as the child session; parent GNOME has normal keys.
run_cage_session "$WLR_RENDERER" systemd-inhibit --what=handle-power-key:handle-suspend-key:handle-hibernate-key:handle-lid-switch \
    --who=ToddlerBox --why='Child session' --mode=block \
    /usr/local/libexec/toddlerbox-cage -- .venv/bin/python -m toddlerbox.launcher
