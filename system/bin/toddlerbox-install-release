#!/usr/bin/python3
"""Install an app bundle from this build recipe. Run in parent mode as root."""
import hashlib
import json
import os
import stat
from pathlib import Path, PurePosixPath
import sys
import tarfile
import tempfile
import time

# Shared helpers are root-owned and ship with this system image, not the bundle.
sys.path.insert(0, "/usr/local/lib/toddlerbox-system")
from controller import (data_schema, release_lock, release_target,
                        replace_release_link, sync_directory)


def verify_ancestors(root: Path) -> None:
    """Production releases and their lock must remain exclusively root controlled."""
    for path in [*reversed(root.parents), root, root / "releases", root / ".release.lock"]:
        if not path.exists() and not path.is_symlink():
            continue
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            raise ValueError("Unsafe release ancestor or lock")
        if root == Path("/opt/toddlerbox") and (info.st_uid != 0 or info.st_mode & 0o022):
            raise ValueError("Release ancestors must be root-owned and not writable by others")
        if stat.S_ISREG(info.st_mode) and info.st_nlink != 1:
            raise ValueError("Hardlinked release lock")


def tree_record(directory: Path, *, production: bool) -> dict:
    """Compare every entry without following links, including executable caches."""
    result = {}

    def visit(path):
        info = path.lstat()
        mode = stat.S_IMODE(info.st_mode)
        if production and (info.st_uid != 0 or (not stat.S_ISLNK(info.st_mode) and mode & 0o022)):
            raise ValueError("Release must be root-owned and not writable by others")
        name = str(path.relative_to(directory))
        if stat.S_ISDIR(info.st_mode):
            result[name] = ("directory", mode)
            for entry in sorted(path.iterdir()):
                visit(entry)
        elif stat.S_ISREG(info.st_mode):
            if info.st_nlink != 1:
                raise ValueError("Hardlinked release file")
            with path.open("rb") as handle:
                result[name] = ("file", mode, hashlib.file_digest(handle, "sha256").hexdigest())
        elif stat.S_ISLNK(info.st_mode):
            result[name] = ("symlink", os.readlink(path))
        else:
            raise ValueError("Unsupported release file type")

    visit(directory)
    return result


APPLIANCE_REFUSAL = ("On the appliance, releases install through ToddlerBox Setup & Maintenance "
                     "(signed updates). For recovery only, rerun with --unsigned-recovery.")


def journals(state: Path) -> list:
    records = []
    for path in sorted((state / "updates").glob("*/state.json")):
        try:
            records.append(json.loads(path.read_text()))
        except (OSError, ValueError):
            records.append({"status": "unreadable"})
    return records


def appliance_guard(state: Path, *, journaled: bool, unsigned_recovery: bool) -> None:
    """Journal-bypassing installs would leave links the boot gate later overrides."""
    if journaled or not (state / "appliance-v1").exists():
        return
    if not unsigned_recovery:
        raise ValueError(APPLIANCE_REFUSAL)
    active = {"applying", "restoring", "pending", "unreadable"}
    if (state / "maintenance").exists() or any(record.get("status") in active for record in journals(state)):
        raise ValueError("An update or recovery is in progress; finish it in ToddlerBox Setup & Maintenance first.")


def referenced_releases(root: Path, state: Path) -> set:
    names = set()
    for link in ("current", "previous"):
        try:
            names.add(release_target(root, link).name)
        except (OSError, ValueError):
            pass
    for record in journals(state):
        links = record.get("old_links")
        if isinstance(links, dict):
            names.update(value for value in links.values() if isinstance(value, str))
    return names


def fsync_tree(directory: Path) -> None:
    # Publish only fully written files: a power cut after the rename must not
    # leave a release directory of empty files that blocks this ID forever.
    for parent, directories, files in os.walk(directory):
        for name in files:
            path = Path(parent) / name
            if not path.is_symlink():
                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
                try:
                    os.fsync(fd)
                finally:
                    os.close(fd)
        fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def install(bundle: Path, expected_digest: str, *, root: Path = Path("/opt/toddlerbox"),
            mode_file: Path = Path("/run/toddlerbox-system/mode"),
            state: Path = Path("/var/lib/toddlerbox-system"),
            journaled: bool = False, unsigned_recovery: bool = False) -> str:
    # Keep the verified file descriptor open: replacing the bundle pathname after
    # hashing cannot substitute a different archive during extraction.
    verify_ancestors(root)
    appliance_guard(state, journaled=journaled, unsigned_recovery=unsigned_recovery)
    with release_lock(root), bundle.open("rb") as handle:
        if mode_file.read_text().strip() != "parent":
            raise ValueError("Enter parent mode before installing a release.")
        digest = hashlib.file_digest(handle, "sha256").hexdigest()
        if digest != expected_digest:
            raise ValueError("Bundle checksum does not match.")
        handle.seek(0)
        current = release_target(root, "current")
        with tarfile.open(fileobj=handle, mode="r:gz") as archive:
            members = archive.getmembers()
            ids = {PurePosixPath(m.name).parts[0] for m in members if PurePosixPath(m.name).parts}
            if len(ids) != 1:
                raise ValueError("Bundle must contain exactly one release.")
            release_id = ids.pop()
            if len(release_id) != 16 or any(c not in "0123456789abcdef" for c in release_id):
                raise ValueError("Invalid release ID.")
            destination = root / "releases" / release_id
            if destination.is_symlink() or (destination.exists() and not destination.is_dir()):
                raise ValueError("Unsafe existing release; no files changed.")

            def safe_member(member, directory):
                path = PurePosixPath(member.name)
                if not path.parts or path.is_absolute() or ".." in path.parts or path.parts[0] != release_id:
                    raise ValueError("Unsafe archive path")
                # uv's interpreter link is the only allowed absolute symlink.
                if member.issym() and member.name == f"{release_id}/.venv/bin/python" and member.linkname == "/usr/bin/python3":
                    return member.replace(uid=0, gid=0, uname="root", gname="root")
                filtered = tarfile.data_filter(member, directory)
                if filtered is not None:
                    filtered = filtered.replace(uid=0, gid=0, uname="root", gname="root")
                return filtered

            with tempfile.TemporaryDirectory(dir=root / "releases", prefix=".install-") as staging:
                archive.extractall(staging, filter=safe_member)
                candidate = Path(staging) / release_id
                for required in ["src/toddlerbox/launcher.py", ".venv/bin/python", "uv.lock"]:
                    if not (candidate / required).exists():
                        raise ValueError(f"Bundle missing {required}")
                if data_schema(candidate, legacy=False) != data_schema(current):
                    raise ValueError("Release data schemas differ; a supported migration is required.")
                # Everything is root-owned; child accounts have no release write access.
                production = root == Path("/opt/toddlerbox")
                candidate_record = tree_record(candidate, production=production)
                if destination.exists() and tree_record(destination, production=production) != candidate_record:
                    if release_id in referenced_releases(root, state):
                        raise ValueError("Existing release differs from verified archive; no files changed.")
                    # Usually a torn earlier install. Nothing refers to it: keep it aside, never delete it.
                    os.rename(destination, root / "releases" / f".conflict-{release_id}-{time.time_ns()}")
                if destination.exists():
                    if destination == current:
                        return release_id  # Retain the distinct previous fallback.
                else:
                    fsync_tree(candidate)
                    os.rename(candidate, destination)
        os.sync()
        sync_directory(root / "releases")
        # Persist fallback first. If interrupted before current changes, the old
        # current remains available through both links; neither target is lost.
        replace_release_link(root, "previous", current)
        replace_release_link(root, "current", destination)
        return release_id


def main() -> None:
    flags = {"--journaled", "--unsigned-recovery"}
    arguments = [argument for argument in sys.argv[1:] if argument not in flags]
    if os.geteuid() != 0 or len(arguments) != 2:
        sys.exit("Usage: sudo toddlerbox-install-release BUNDLE.tar.gz EXPECTED_SHA256 [--unsigned-recovery]")
    try:
        release_id = install(Path(arguments[0]), arguments[1], journaled="--journaled" in sys.argv,
                             unsigned_recovery="--unsigned-recovery" in sys.argv)
    except (OSError, ValueError, tarfile.TarError) as error:
        sys.exit(str(error))
    print(f"Installed {release_id}; previous release retained. Start child mode to validate.")


if __name__ == "__main__":
    main()
