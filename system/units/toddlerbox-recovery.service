[Unit]
Description=Disable child autologin if the independent controller fails

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p /var/lib/toddlerbox-system; touch /var/lib/toddlerbox-system/parent-mode; printf "[daemon]\nAutomaticLoginEnable=false\n" > /etc/gdm3/custom.conf'
ExecStart=/usr/bin/systemctl --no-block restart gdm3.service
